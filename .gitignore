# BuildStack Root .gitignore

# =========================
# Backend (Spring Boot)
# =========================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
backend/build/
backend/.env
backend/uploads/

# =========================
# Frontend (React/Vite)
# =========================
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.env
frontend/.env.local
frontend/.env.*.local
frontend/*.local

# =========================
# Logs
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# =========================
# OS Files
# =========================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================
# IDEs and Editors
# =========================
.idea/
*.iws
*.iml
*.ipr
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.apt_generated/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
